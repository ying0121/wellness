<!DOCTYPE html>
<html lang="en">

<%- include('header') %>
<style>
.popover .popover-body { padding: 0; }
.alert-preview-landing .alert-preview-image-wrap img { border-radius: 4px; }
.alert_preview_popover_close { cursor: pointer !important; padding: 4px 8px !important; }
.alert_preview_readmore { text-decoration: underline; cursor: pointer; }
</style>
<body id="kt_body" class="header-fixed header-mobile-fixed subheader-enabled subheader-fixed aside-enabled aside-fixed aside-minimize-hoverable page-loading">
    <%- include('mobile-navbar') %>
    <div class="d-flex flex-column flex-root">
        <div class="d-flex flex-row flex-column-fluid page">
             <%- include('sidebar') %>
            <div class="d-flex flex-column flex-row-fluid wrapper pt-20" id="kt_wrapper">
                 <%- include('navbar') %>
                <div class="content d-flex flex-column flex-column-fluid p-10">
                    <div class="row my-3 p-10 bg-white border rounded">
                        <div class="col-12 mb-4 d-flex justify-content-between align-items-center my-5">
                            <div><h3>Alert Table</h3></div>
                            <div class='btn btn-light-primary' id="alert_add"><i class='fa fa-plus'></i> Add New</div>
                        </div>
                        <div class="col-12">
                            <div class="table">
                                <table class="table" id="alert_table">
                                    <thead>
                                        <th>Title</th>
                                        <th>Message</th>
                                        <th>Alert Range</th>
                                        <th>Status</th>
                                        <th>Alert Type</th>
                                        <th>Send Status</th>
                                        <th>Created By</th>
                                        <th style="width:150px;">Action</th>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="alert_modal">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <input type="hidden" id="alert-chosen_id" />
                <input type="hidden" id="alert-modal_type" />
                <div class="modal-header">
                    <h4 class="modal-title" style="font-weight:500;">Alert Editor</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-5">
                            <div class="ml-3">
                                <h5>Alert Title(EN)</h5>
                            </div>
                            <input class="form-control" id="alert-title" />
                        </div>
                        <div class="col-md-6 mb-5">
                            <div class="ml-3">
                                <h5>Alert Title(ES)</h5>
                            </div>
                            <input class="form-control" id="alert-title-es" />
                        </div>
                        <div class="col-md-6 mb-5">
                            <div class="ml-3">
                                <h5>Alert Message(EN)</h5>
                            </div>
                            <div id="alert-message" class="alert-summernote"></div>
                        </div>
                        <div class="col-md-6 mb-5">
                            <div class="ml-3">
                                <h5>Alert Message(ES)</h5>
                            </div>
                            <div id="alert-message-es" class="alert-summernote"></div>
                        </div>
                        <div class="col-md-6 mb-5">
                            <div class="ml-3">
                                <h5>Alert Description(EN) <span class="text-danger">*</span></h5>
                            </div>
                            <div id="alert-description" class="alert-summernote"></div>
                        </div>
                        <div class="col-md-6 mb-5">
                            <div class="ml-3">
                                <h5>Alert Description(ES)</h5>
                            </div>
                            <div id="alert-description-es" class="alert-summernote"></div>
                        </div>
                        <div class="col-md-8 mb-5">
                            <div class="ml-3">
                                <h5>Alert Range</h5>
                            </div>
                            <div class="d-flex justify-content-center">
                                <input class="form-control mr-3" type="datetime-local" id="alert-start" />
                                <input class="form-control ml-3" type="datetime-local" id="alert-end" />
                            </div>
                        </div>
                        <div class="col-md-4 mb-5">
                            <div class="ml-3">
                                <h5>Status</h5>
                            </div>
                            <select class="form-control" id="alert-status">
                                <option value="0">Inactive</option>
                                <option value="1">Active</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <hr>
                        </div>
                        <div class="col-md-12 mx-5 mb-7 d-flex justify-content-start align-items-center">
                            <input type="checkbox" style="width: 24px; height: 24px;" id="alert-image-status" class="align-items-center mx-1" />
                            <label for="alert-image-status" class="align-items-center m-0">&nbsp;&nbsp;Upload Image</label>
                        </div>
                        <div class="col-md-4 mb-5 image-component d-none">
                            <div class="custom-file form-group">
                                <label class="custom-file-label" for="alert-image">Select an image</label>
                                <input type="file" accept="image/*" class="custom-file-input mx-3" id="alert-image" />
                            </div>
                        </div>
                        <div class="col-md-8 mb-5 image-component d-none">
                            <div class="alert-image-preview-wrap border rounded bg-light d-flex align-items-center justify-content-center overflow-hidden" style="min-height: 200px; max-height: 280px;">
                                <img id="alert-image-preview" src="" alt="Preview" class="img-fluid" style="max-height: 280px; object-fit: contain; display: none;" />
                                <span id="alert-image-preview-placeholder" class="text-muted">No image selected</span>
                            </div>
                            <h6 id="alert-image-path" class="mt-2 small text-secondary"></h6>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="row w-100">
                        <div class="col-md-4">
                            <div class="d-flex justify-content-start align-items-center">
                                <input type="checkbox" style="width: 24px; height: 24px;" id="alert-type" class="mx-1" />
                                <label for="alert-type" class="align-items-center m-0">
                                    <h6 class="m-0">&nbsp;&nbsp;Only Once</h6>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-8 d-flex justify-content-end">
                            <button type="button" class="btn btn-primary mr-2" id="alert_modal_submit_btn">Submit</button>
                            <button type="button" class="btn btn-danger ml-2" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

<script>
    var ALERT_PREVIEW_IMAGE_BASE = "<%= site_url %>/assets/images/alerts/"
    $(document).ready(function() {
        $('.alert-summernote').summernote({
            tabsize: 1,
            height: 120,
        })

        const alertTable = $("#alert_table").DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search alerts",
            },
            "ajax": {
                "url": "<%= site_url + prefix %>/alerts/read",
                "type": "GET"
            },
            "columns": [{
                    data: "title"
                },
                {
                    data: "message"
                },
                {
                    data: "start",
                    render: function(data, type, row) {
                        return `<div class="start-date">${new Date(row.start).toLocaleDateString('en-US', {month: '2-digit', day: '2-digit', year: 'numeric', hour:"2-digit", minute:"2-digit", hour12: true})}</div>
                        <div class="start-date">${new Date(row.end).toLocaleDateString('en-US', {month: '2-digit', day: '2-digit', year: 'numeric', hour:"2-digit", minute:"2-digit", hour12: true})}</div>`
                    }
                },
                {
                    data: "status",
                    render: function(data, type, row) {
                        return row.status == 0 ? `<span class="text-danger">In Active</span>` : `<span class="text-primary">Active</span>`
                    }
                },
                {
                    data: "type",
                    render: function(data, type, row) {
                        return row.type == "once" ? `<span class="bg-light-primary text-primary p-2 rounded">Only Once</span>` : `<span class="bg-light-success text-success p-2 rounded">Always</span>`
                    }
                },
                {
                    data: "sent",
                    render: function(data, type, row) {
                        return row.sent == 0 ? `<span class="text-primary">No</span>` : `<span class="text-danger">Yes</span>`
                    }
                },
                {
                    data: "created_by",
                    render: function(data, type, row) {
                        return row.manager ? row.manager.fname + " " + row.manager.lname : "Undefined Manager"
                    }
                },
                {
                    data: "id",
                    render: function(data, type, row) {
                        return `<div idkey="${row.id}">
                            <span class="btn btn-icon btn-sm btn-light-info alert_preview_btn" title="Preview"><i class="fas fa-eye"></i></span>
                            <span class="btn btn-icon btn-sm btn-light-primary alert_edit_btn" title="Edit"><i class="fas fa-edit"></i></span>
                            <span class="btn btn-icon btn-sm btn-light-danger alert_delete_btn" title="Delete"><i class="fas fa-trash"></i></span>
                        </div>`
                    }
                }
            ]
        })

        $("#alert_add").click(() => {
            $("#alert-modal_type").val("0")

            $("#alert-title").val("")
            $("#alert-message").summernote("code", "")
            $("#alert-description").summernote("code", "")
            $("#alert-title-es").val("")
            $("#alert-message-es").summernote("code", "")
            $("#alert-description-es").summernote("code", "")
            $("#alert-start").val("")
            $("#alert-end").val("")
            $("#alert-status").val(0)
            $("#alert-type").prop("checked", false)

            $("#alert-image-status").prop("checked", false)
            $(".image-component").addClass("d-none")
            $("#alert-image-path").text("")
            $("#alert-image").val("")
            $("#alert-image-preview").attr("src", "").hide()
            $("#alert-image-preview-placeholder").show()

            $("#alert_modal").modal("show")
        })

        var alertPreviewObjectUrl = null
        function setAlertImagePreview(src, isObjectUrl) {
            if (alertPreviewObjectUrl) {
                URL.revokeObjectURL(alertPreviewObjectUrl)
                alertPreviewObjectUrl = null
            }
            var $img = $("#alert-image-preview")
            var $ph = $("#alert-image-preview-placeholder")
            if (src) {
                $img.attr("src", src).show()
                $ph.hide()
                if (isObjectUrl) alertPreviewObjectUrl = src
            } else {
                $img.attr("src", "").hide()
                $ph.show()
            }
        }

        $("#alert-image").on("change", function() {
            var file = this.files && this.files[0]
            if (file && file.type.indexOf("image/") === 0) {
                setAlertImagePreview(URL.createObjectURL(file), true)
                $("#alert-image-path").text(file.name)
                $("#alert-image").siblings(".custom-file-label").addClass("selected").text(file.name)
            } else {
                setAlertImagePreview(null)
                $("#alert-image-path").text("")
            }
        })
        
        $("#alert_modal").on("hidden.bs.modal", function() {
            setAlertImagePreview(null)
        })

        $("#alert_modal_submit_btn").click(() => {
            var descEn = ($("#alert-description").summernote('code') || '').replace(/<[^>]*>/g, '').trim()
            if (!descEn) {
                toastr.error("Description (EN) is required.")
                return
            }
            var fd = new FormData()
            fd.append("id", $("#alert-chosen_id").val())
            fd.append("title", $("#alert-title").val())
            fd.append("message", $("#alert-message").summernote('code').replace(/<[^>]*>/g, ''))
            fd.append("description", $("#alert-description").summernote('code').replace(/<[^>]*>/g, ''))
            fd.append("title_es", $("#alert-title-es").val())
            fd.append("message_es", $("#alert-message-es").summernote('code').replace(/<[^>]*>/g, ''))
            fd.append("description_es", $("#alert-description-es").summernote('code').replace(/<[^>]*>/g, ''))
            fd.append("start", $("#alert-start").val())
            fd.append("end", $("#alert-end").val())
            fd.append("status", $("#alert-status").val())
            fd.append("type", $("#alert-type").prop("checked") == true ? "once" : "always")
            fd.append("created_by", "<%= user.id %>")
            fd.append("image_actived", $("#alert-image-status").prop("checked") === true ? 1 : 0)
            if ($("#alert-image-status").prop("checked") == true) {
                var image = $('#alert-image')[0].files
                fd.append("img", image[0])
                fd.append("img_length", 1)
            }
            $.post({
                url: $("#alert-modal_type").val() == "0" ? "<%= site_url + prefix %>/alerts/create" : "<%= site_url + prefix %>/alerts/update",
                method: "POST",
                data: fd,
                contentType: false,
                processData: false,
                dataType: "json",
                success: function(res) {
                    if (res.status == "success") {
                        toastr.success("Action Success!")
                        $("#alert_modal").modal("hide")
                        alertTable.ajax.reload()
                    } else {
                        toastr.error(res.error || "Action Failed!")
                    }
                },
                error: function(xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.error) ? xhr.responseJSON.error : "An error was occurred on the server!"
                    toastr.error(msg)
                }
            })
        })

        $(document).on("click", ".alert_preview_btn", function(e) {
            e.stopPropagation()
            var id = $(this).parent().attr("idkey")
            var $btn = $(this)
            $(".alert_preview_btn").not($btn).popover("dispose")
            $.post({
                url: "<%= site_url + prefix %>/alerts/chosen",
                method: "POST",
                data: { id: id },
                dataType: "json",
                success: function(res) {
                    var title = (res.title || "Alert").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                    var startStr = res.start ? new Date(res.start).toLocaleDateString() : ""
                    var endStr = res.end ? new Date(res.end).toLocaleDateString() : ""
                    var desc = (res.description && res.description.trim()) ? res.description : (res.description_es && res.description_es.trim()) ? res.description_es : ""
                    var msg = (res.message && res.message.trim()) ? res.message : (res.message_es && res.message_es.trim()) ? res.message_es : ""
                    var imgHtml = res.image ? '<div class="alert-preview-image-wrap text-center py-3"><img src="' + ALERT_PREVIEW_IMAGE_BASE + res.image + '" alt="" class="img-fluid" style="max-height: 320px; width: 100%; object-fit: contain;" /></div>' : ""
                    var datesHtml = (startStr || endStr) ? '<div class="alert-preview-dates fst-italic mb-3 opacity-90">' + (startStr && endStr ? startStr + " ~ " + endStr : startStr || endStr) + '</div>' : ""
                    var descHtml = desc ? '<div class="mb-3"><div class="fw-semibold mb-1">Description</div><div class="overflow-auto alert-preview-text" style="max-height: 200px; line-height: 1.5;">' + desc + '</div></div>' : ""
                    var msgHtml = msg ? '<div><div class="fw-semibold mb-1">Message</div><div class="overflow-auto alert-preview-text" style="max-height: 200px; line-height: 1.5;">' + msg + '</div></div>' : ""
                    var emptyHtml = (!desc && !msg) ? '<div class="opacity-75">No content.</div>' : ""
                    var inner = '<div class="alert-preview-outer rounded border shadow-sm" style="min-width: 400px; max-width: 540px; border-color: #dee2e6 !important;">' +
                        '<div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-white rounded-top" style="border-color: #dee2e6 !important;">' +
                        '<span class="font-weight-bold">Alert Preview (as on landing page)</span>' +
                        '<button type="button" class="alert_preview_popover_close btn btn-link p-0 m-0 border-0" aria-label="Close" style="font-size: 1.5rem; line-height: 1; color: #6c757d; text-decoration: none;">&times;</button>' +
                        '</div>' +
                        '<div class="alert-preview-landing rounded-bottom overflow-hidden" style="background: #0d1b2a; color: #fff;">' +
                        '<div class="px-4 pt-4 pb-2">' +
                        '<div class="font-weight-bold mb-2" style="font-size: 1.35rem; color: #fff;">' + title + '</div>' +
                        '<div class="mb-3" style="font-size: 0.95rem; color: rgba(255,255,255,0.9);">' + title + ' <a href="#" class="alert_preview_readmore" style="color: #fff;">Read more &gt;&gt;</a></div>' +
                        imgHtml +
                        '<div class="px-4 py-3">' + datesHtml + descHtml + msgHtml + emptyHtml + '</div>' +
                        '<div class="px-4 pb-4"><button type="button" class="btn btn-outline-light btn-sm alert_preview_popover_close">Close</button></div>' +
                        '</div></div>'
                    $btn.popover("dispose")
                    $btn.popover({
                        content: inner,
                        html: true,
                        trigger: "manual",
                        placement: "left"
                    })
                    $btn.popover("show")
                    var outsideClickHandler
                    var handlersAttached = false
                    function attachCloseHandlers() {
                        if (handlersAttached) return
                        var $tip = ($btn.data("bs.popover") && $btn.data("bs.popover").$tip) || $(".popover").last()
                        if (!$tip || !$tip.length) return
                        handlersAttached = true
                        function closePreview() {
                            $btn.popover("dispose")
                            $(document).off("click", outsideClickHandler)
                        }
                        $tip.on("click.preview", ".alert_preview_popover_close, .alert_preview_readmore", function(e) {
                            e.preventDefault()
                            e.stopPropagation()
                            closePreview()
                        })
                        outsideClickHandler = function(ev) {
                            if (!$(ev.target).closest(".popover").length) closePreview()
                        }
                        setTimeout(function() {
                            $(document).on("click", outsideClickHandler)
                        }, 80)
                    }
                    $btn.one("shown.bs.popover", attachCloseHandlers)
                    setTimeout(attachCloseHandlers, 150)
                },
                error: function() {
                    toastr.error("Failed to load alert.")
                }
            })
        })

        $(document).on("click", ".alert_edit_btn", function() {
            $("#alert-modal_type").val("1")
            $("#alert-chosen_id").val($(this).parent().attr("idkey"))
            $.post({
                url: "<%= site_url + prefix %>/alerts/chosen",
                method: "POST",
                data: {
                    id: $(this).parent().attr("idkey")
                },
                dataType: "json",
                success: function(res) {
                    const startDate = res.start ? new Date(res.start) : null
                    const endDate = res.end ? new Date(res.end) : null
                    $("#alert-title").val(res.title)
                    $("#alert-message").summernote("code", res.message)
                    $("#alert-description").summernote("code", res.description)
                    $("#alert-title-es").val(res.title_es)
                    $("#alert-message-es").summernote("code", res.message_es)
                    $("#alert-description-es").summernote("code", res.description_es)
                    $("#alert-start").val(startDate ? startDate.toISOString().substr(0, 10) + " " + startDate.toTimeString().substr(0, 8) : "")
                    $("#alert-end").val(endDate ? endDate.toISOString().substr(0, 10) + " " + endDate.toTimeString().substr(0, 8) : "")
                    $("#alert-status").val(res.status)
                    $("#alert-image-status").prop("checked", res.image_actived == 1 ? true : false)
                    $("#alert-image").val("")
                    if (res.image_actived == 1) {
                        $(".image-component").removeClass("d-none")
                        if (res.image) {
                            setAlertImagePreview("<%= site_url %>/assets/images/alerts/" + res.image, false)
                            $("#alert-image-path").text(res.image)
                        } else {
                            setAlertImagePreview(null)
                            $("#alert-image-path").text("")
                        }
                    } else {
                        $(".image-component").addClass("d-none")
                        setAlertImagePreview(null)
                        $("#alert-image-path").text("")
                    }
                    res.type == "once" ? $("#alert-type").prop("checked", true) : $("#alert-type").prop("checked", false)

                    $("#alert_modal").modal("show")
                },
                error: function(error) {
                    toastr.error("An error was occurred on the server!")
                }
            })
        })

        $(document).on("click", ".alert_delete_btn", function() {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: '<%= site_url + prefix %>/alerts/delete',
                        method: "POST",
                        data: {
                            id: $(this).parent().attr("idkey")
                        },
                        dataType: "json",
                        success: function(res) {
                            if (res.status == "success") {
                                toastr.success("Action Success!")
                            } else {
                                toastr.error("Action Failed!")
                            }
                            $("#alert_modal").modal("hide")
                            alertTable.ajax.reload()
                        },
                        error: function(error) {
                            toastr.error("An error was occured on the server!")
                        }
                    });
                }
            });
        })

        $("#alert-image-status").on("change", function() {
            if ($(this).prop("checked") == true) {
                $(".image-component").removeClass("d-none")
            } else {
                $(".image-component").addClass("d-none")
            }
        })
    })
</script>

</html>
