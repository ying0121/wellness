<!-- Header -->
<header class="sticky-md-top" style="border-bottom: 2px solid #1B5D92; box-shadow: 0px 4px 4px 0px #A0A0A060;" id="main-header">
    <div class="d-none d-lg-flex d-flex justify-content-center align-items-center flex-wrap py-1" style="background-color: #407081;">
        <div>
            <i class="fa fa-phone text-primary fs-6"></i>&nbsp;:&nbsp;
            <a href="tel:<%= contact_info.tel %>" class="text-white fs-7"><%= contact_info.tel %></a>
        </div>
        <div class="text-white">
            &nbsp;&nbsp;|&nbsp;
            <i class="fa fa-fax text-info fs-6"></i>&nbsp;:&nbsp;
            <a href="tel:<%= contact_info.tel %>" class="text-white fs-7"><%= contact_info.tel %></a>
        </div>
        <% if (contact_info.email) { %>
            <div>
                <span class="d-none d-md-inline text-white">&nbsp;&nbsp;|&nbsp;&nbsp;</span><i class="fa fa-envelope text-success fs-6"></i>&nbsp;:&nbsp;
                <a href="mailto:<%= contact_info.email %>" class="text-white fs-7"><%= contact_info.email %></a>
            </div>
        <% } %>
        <div class="text-white">
            &nbsp;&nbsp;|&nbsp;<%= component_text.t_topbar_emergency_call %>
        </div>
    </div>
    <!-- Nav Bar -->
    <nav class="navbar navbar-expand-lg bg-white">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="d-none d-sm-block navbar-brand" href="<%= site_url %>"><img src="<%= site_url %>/assets/images/logo.png" class="img-fluid" alt="Logo" /></a>
            <a class="d-block d-sm-none navbar-brand" href="<%= site_url %>"><img src="<%= site_url %>/assets/images/favicon.png" class="img-fluid" alt="Logo" style="width: 40px;" /></a>
            <!-- Sign In/Out, Pt Info, Language Buttons In Mobile Mode -->
            <div class="d-flex justify-content-start align-items-center flex-wrap gap-1 d-lg-none">
                <div class="d-flex justify-content-start align-items-center gap-1">
                    <% if (contact_info.portal_show == 1) { %>
                        <a href="<%= contact_info.portal %>" class="themesflat-button font-default process mx-1 text-gray" target="_blank"><span><%= component_text.link_portal %></span></a>
                    <% } %>
                    <% if (area_toggle.vault_area) { %>
                        <% if (!patient_id || !patient_name) { %>
                            <a href="<%= site_url %>/login" class="themesflat-button font-default process mx-1 text-gray"><span><%= component_text.link_sign_in %></span></a>
                        <% } %>
                    <% } %>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <div class="btn py-0 px-1 langbtn <%= language === "en" ? "active" : "" %>" onclick="setLang('en');">
                        <img src="<%= site_url %>/assets/images/flags/en.png" style="width: 16px; height: 16px;" />
                    </div>
                    <div class="btn py-0 px-1 langbtn <%= language === "en" ? "" : "active" %>" onclick="setLang('es');">
                        <img src="<%= site_url %>/assets/images/flags/es.png" style="width: 16px; height: 16px;" />
                    </div>
                    <% if (patient_id && patient_name) { %>
                        <div class="d-flex justify-content-center align-items-center mx-3">
                            <button class="d-none" data-bs-toggle="modal" data-bs-target="#info-manage-modal" id="patient-info-modal-view"></button>
                            <div class="patient-info bg-primary d-flex justify-content-center align-items-center rounded rounded-pill fs-4 text-white m-0" style="width: 32px; height: 32px; cursor: pointer;">
                                <%= patient_info.fname[0] %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
            <!-- Item Button In Mobile Mode -->
            <button class="btn btn-transparent-secondary navbar-toggler p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Nav Items -->
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="w-auto navbar-nav me-auto mb-2 mb-lg-0 gap-1 scroll-y overflow-lg-x-visible overflow-lg-y-visible h-lg-240px flex-lg-wrap">
                    <li class="nav-item"><a class="nav-link <%= page_tag == "home" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>"><%= component_text.menu_home %></a></li>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "the-clinic" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/the-clinic"><%= component_text.menu_the_clinic %></a></li>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "about-us" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/about-us"><%= component_text.menu_about_us %></a></li>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "services" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/services"><%= component_text.menu_services %></a></li>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "letters" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/letters"><%= component_text.menu_letters %></a></li>
                    <% if (area_toggle.fee_area == 1) { %>
                        <li class="nav-item"><a class="nav-link <%= page_tag == "fees" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/fees"><%= component_text.menu_fees %></a></li>
                    <% } %>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "orientation" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/orientation"><%= component_text.menu_orientation %></a></li>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "community-resources" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/community-resources"><%= component_text.menu_community_resources %></a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle <%= page_tag == "educations" ? "active fw-bold" : "fw-semibold" %>" href="javascript:;" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= component_text.menu_education %></i></a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=asthma"><%= component_text.menu_asthma %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=aye_vision"><%= component_text.menu_aye_vision %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=cholesterol"><%= component_text.menu_cholesterol %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=diabietes"><%= component_text.menu_diabietes %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=drug_abuse"><%= component_text.menu_drug_abuse %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=nutrition"><%= component_text.menu_nutrition %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=pain"><%= component_text.menu_pain %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=pain_back"><%= component_text.menu_pain_back %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=pulmonary_disease"><%= component_text.menu_pulmonary_disease %></a></li>
                            <li><a class="dropdown-item" href="<%= site_url %>/educations?p=tobacco_treatment"><%= component_text.menu_tobacco_treatment %></a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "insurances" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/insurances"><%= component_text.menu_insurances %></a></li>
                    <li class="nav-item"><a class="nav-link <%= page_tag == "contact" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/contact"><%= component_text.menu_contact %></a></li>
                    <% if (isLoggedIn) { %>
                        <li class="nav-item"><a class="nav-link <%= page_tag == "vault" ? "active fw-bold" : "fw-semibold" %>" href="<%= site_url %>/vault"><%= component_text.menu_vault %></a></li>
                    <% } %>
                </ul>
                <!-- Sign In/Out, Pt Info, Language Buttons In Browser Mode -->
                <div class="d-none d-lg-flex justify-content-lg-start align-items-lg-center gap-4">
                    <div class="d-flex justify-content-start align-itmes-center gap-1">
                        <% if (contact_info.portal_show == 1) { %>
                            <a href="<%= contact_info.portal %>" class="themesflat-button font-default process mx-1 text-gray" target="_blank"><span><%= component_text.link_portal %></span></a>
                        <% } %>
                        <% if (area_toggle.vault_area) { %>
                            <% if (!patient_id || !patient_name) { %>
                                <a href="<%= site_url %>/login" class="themesflat-button font-default process mx-1 text-gray"><span><%= component_text.link_sign_in %></span></a>
                            <% } %>
                        <% } %>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <div class="btn p-1 langbtn <%= language === "en" ? "active" : "" %>" onclick="setLang('en');">
                            <img src="<%= site_url %>/assets/images/flags/en.png" style="min-width: 20px; max-width: 20px; min-height: 20px; max-height: 20px;" />
                        </div>
                        <div class="btn p-1 langbtn <%= language === "en" ? "" : "active" %>" onclick="setLang('es');">
                            <img src="<%= site_url %>/assets/images/flags/es.png" style="min-width: 20px; max-width: 20px; min-height: 20px; max-height: 20px;" />
                        </div>
                        <% if (isLoggedIn) { %>
                            <div class="d-flex justify-content-center align-items-center mx-3">
                                <button class="d-none" data-bs-toggle="modal" data-bs-target="#info-manage-modal" id="patient-info-modal-view"></button>
                                <div class="patient-info text-white bg-primary d-flex justify-content-center align-items-center rounded rounded-pill fs-3 m-0" style="width: 36px; height: 36px; cursor: pointer;">
                                    <%= patient_info.fname[0] %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <!-- /Nav Bar -->
    <!-- Alert Banner (shown only when alerts exist) -->
    <% if (typeof alerts !== 'undefined' && alerts.length > 0) { %>
    <div class="alert-banner border-top border-2 border-danger bg-light py-2 px-3" style="background: linear-gradient(90deg, #fff5f5 0%, #ffe5e5 100%);">
        <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <i class="fa fa-exclamation-circle text-danger fs-5"></i>
                <span class="fw-semibold text-dark"><%= component_text.t_notification %>:</span>
                <% for (let i = 0; i < alerts.length; i++) { %>
                    <div class="dropdown d-inline-block">
                        <button type="button" class="btn btn-link btn-sm p-0 text-danger fw-semibold text-decoration-none dropdown-toggle alert-title-dropdown" data-bs-toggle="dropdown" aria-expanded="false" style="white-space: nowrap;">
                            <%= alerts[i].title %>
                        </button>
                        <div class="dropdown-menu dropdown-menu-start shadow-sm p-0" style="min-width: 380px; max-width: 480px; max-height: 90vh; overflow-y: auto;">
                            <% if (alerts[i].image) { %>
                                <div class="text-center bg-light border-bottom p-3">
                                    <img src="<%= site_url + "/assets/images/alerts/" + alerts[i].image %>" alt="<%= alerts[i].title %>" class="img-fluid rounded" style="max-height: 360px; width: auto; object-fit: contain;" />
                                </div>
                            <% } %>
                            <div class="p-3 fs-6">
                                <div class="fst-italic text-muted mb-3"><%= new Date(alerts[i].start).toLocaleDateString() %> ~ <%= new Date(alerts[i].end).toLocaleDateString() %></div>
                                <% 
                                    var descText = (alerts[i].description && alerts[i].description.trim()) ? alerts[i].description : (alerts[i].desc && alerts[i].desc.trim()) ? alerts[i].desc : '';
                                    var msgText = (alerts[i].message && alerts[i].message.trim()) ? alerts[i].message : '';
                                %>
                                <% if (descText) { %>
                                    <div class="mb-3">
                                        <div class="fw-semibold mb-1">Description</div>
                                        <div class="alert-dropdown-body" style="max-height: 280px; overflow-y: auto; line-height: 1.5;"><%- descText %></div>
                                    </div>
                                <% } %>
                                <% if (msgText) { %>
                                    <div>
                                        <div class="fw-semibold mb-1">Message</div>
                                        <div class="alert-dropdown-body" style="max-height: 280px; overflow-y: auto; line-height: 1.5;"><%- msgText %></div>
                                    </div>
                                <% } %>
                                <% if (!descText && !msgText) { %>
                                    <div class="alert-dropdown-body text-muted">No content.</div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% if (i < alerts.length - 1) { %><span class="text-muted mx-1">|</span><% } %>
                <% } %>
            </div>
        </div>
    </div>
    <% } %>
    <!-- /Alert Banner -->
</header>
<!-- /Header -->
<script>window.ALERTS_DATA = <%- JSON.stringify(typeof alerts !== 'undefined' ? alerts : []) %>;</script>
<!-- Work Time -->
<div id="hours-toggle" class="hours-toggle aos" data-aos="fade-left">
    <i class="fa fa-clock fs-5"></i>
</div>
<!-- /Work Time -->
<!-- Working Hours Panel -->
<div id="working-hours" class="working-hours">
    <p class="h4 my-3 ms-4"><%= component_text.t_working_hour %></p>
    <ul>
        <% for (let i=0; i < working_hours.length; i++) { %>
            <div class="mx-1 text-black">
                <i class="fa fa-check text-success mx-2 fs-4"></i>
                <%= working_hours[i].name %> : <%= working_hours[i].time %>
                <hr class="my-3">
            </div>
        <% } %>
    </ul>
</div>
<!-- /Working Hours Panel -->